# Auth.js / Google OAuth (관리자 페이지)
#
# 주의: 파일 이름은 반드시 `.env.local` 입니다. (`.evn.local` 오타는 Next가 읽지 않습니다.)

AUTH_SECRET=
# 또는 NEXTAUTH_SECRET=

# Google Cloud Console > OAuth 클라이언트 (웹)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth.js 기본 이름도 지원합니다.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# 관리자 화이트리스트 (콤마로 여러 개 가능)
ADMIN_EMAIL=teacher@gmail.com
NEXT_PUBLIC_ADMIN_EMAIL=teacher@gmail.com

# 로컬: http://localhost:3000
# 배포: https://x-mafia.vercel.app
AUTH_URL=http://localhost:3000
# 또는 NEXTAUTH_URL=

# Google OAuth Redirect URI 예시
# http://localhost:3000/api/auth/callback/google
# https://x-mafia.vercel.app/api/auth/callback/google
