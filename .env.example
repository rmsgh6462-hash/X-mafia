# Auth.js / Google OAuth (관리자 페이지)
AUTH_SECRET=
# 또는 NEXTAUTH_SECRET=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 또는 아래 이름도 지원합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 관리자 화이트리스트 (콤마로 여러 개 가능)
# 서버 검증용(권장)
ADMIN_EMAIL=teacher@gmail.com
# 요청하신 공개 변수명도 지원합니다.
NEXT_PUBLIC_ADMIN_EMAIL=teacher@gmail.com

# 로컬: http://localhost:3000
# 배포: https://x-mafia.vercel.app
AUTH_URL=http://localhost:3000
# 또는 NEXTAUTH_URL=
